static func clean(value: String) -> String:
	var result = value.to_upper()
	for pair in [["Á","A"],["À","A"],["Ã","A"],["Â","A"],["É","E"],["Ê","E"],["Í","I"],["Ó","O"],["Ô","O"],["Õ","O"],["Ú","U"],["Ç","C"]]:
		result = result.replace(pair[0],pair[1])
	return result
static func draw(target: CanvasItem,value: String,pos: Vector2,size: int,color: Color) -> void:
	var x = pos.x
	for character in clean(value):
		var rows = GLYPHS.get(character,GLYPHS["?"])
		for y in range(7):
			for col in range(5):
				if rows[y] & (1 << (4-col)):
					target.draw_rect(Rect2(x+col*size,pos.y+y*size,size,size),color)
		x += size * 6
